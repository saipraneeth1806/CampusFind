# ========================================================
# CampusFind Environment Variables (.env.example)
# Copy this file to .env and adjust values for your environment.
# Note: .env is in .gitignore and should NEVER be pushed to GitHub!
# ========================================================

# --- AI Configuration (Google Gemini or OpenAI/Ollama) ---
# Paste your Google AI Studio Gemini key here (starts with AIzaSy):
AI_API_KEY=your_gemini_or_openai_api_key_here

# Optional: Base URL (auto-detected for Gemini if using AIzaSy... key)
# For Gemini OpenAI-compatible: https://generativelanguage.googleapis.com/v1beta/openai
# For Local Ollama: http://localhost:11434/v1
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional: Model name (defaults to gemini-2.5-flash-lite for Gemini)
# AI_MODEL=gemini-2.5-flash-lite

# --- Database Configuration (MySQL) ---
# Default connects to local MySQL on port 3306
DB_URL=jdbc:mysql://localhost:3306/campusfind?serverTimezone=UTC&createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password_here

# --- Server Port ---
PORT=8080

# --- Seed Sample Data on Startup (set false in production) ---
SEED_DATA=true
